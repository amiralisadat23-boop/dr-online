import {
  createContext,
  useContext,
  useEffect,
  useMemo,
  useState,
} from "react";

import {
  clearFails,
  clearSession,
  hashPassword,
  lockStatus,
  passwordPolicy,
  readSession,
  registerFail,
  unlockVault,
  verifyPassword,
  writeSession,
} from "./crypto";

import { db, encryptExistingRecords } from "./db";
import { seedIfEmpty } from "./seed";
import { apiLogin, apiRegister, apiRequestOtp, apiVerifyOtp } from "./api";

import type {
  PublicUser,
  Role,
  User,
} from "./types";

function toPublic(u: User): PublicUser {
  const { passwordHash: _hidden, ...rest } = u;
  return rest;
}

type AuthValue = {
  user: PublicUser | null;
  ready: boolean;
  login: (
    identity: string,
    password: string,
    role: Role,
  ) => Promise<string | null>;
  register: (
    payload: RegisterPayload,
  ) => Promise<string | null>;
  changePassword: (
    current: string,
    next: string,
  ) => Promise<string | null>;
  logout: () => void;
  requestOtp: (phone: string) => Promise<{ error: string | null; devCode?: string }>;
  verifyOtp: (phone: string, code: string, role: Role) => Promise<string | null>;
};

export type RegisterPayload = {
  role: Role;
  name: string;
  phone: string;
  password: string;
  nationalId?: string;
  age?: number;
  heightCm?: number;
  weightKg?: number;
  gender?: "زن" | "مرد";
  bloodType?: string;
  caregiverPhone?: string;
  conditions?: string[];
  allergies?: string;
  relation?: string;
  patientNationalId?: string;
};

const AuthContext = createContext<AuthValue | null>(null);

function normalizeApiUser(data: any) {
  return data?.user || data;
}

function apiUserToLocalUser(
  apiUser: any,
  password: string,
): User {
  return {
    id: `api-${String(apiUser.id)}`,
    role: apiUser.role as Role,
    name: apiUser.name,
    phone: apiUser.phone,
    passwordHash: "",
    nationalId: undefined,
  };
}

export function AuthProvider({
  children,
}: {
  children: React.ReactNode;
}) {
  const [user, setUser] =
    useState<PublicUser | null>(null);

  const [ready, setReady] =
    useState(false);

  useEffect(() => {
    (async () => {
      try {
        await seedIfEmpty();

        const session = await readSession();

        if (session) {
          const found =
            await db.users.get(session.userId);

          if (found) {
            await unlockVault();
            await encryptExistingRecords();
            setUser(toPublic(found));
          } else {
            clearSession();
          }
        }
      } catch (error) {
        console.error(
          "Auth initialization failed:",
          error,
        );
      } finally {
        setReady(true);
      }
    })();
  }, []);

  const value = useMemo<AuthValue>(
    () => ({
      user,
      ready,

      logout() {
        clearSession();
        setUser(null);
      },

      async requestOtp(phone: string) {
        const normalizedPhone = phone.trim();

        if (!normalizedPhone) {
          return { error: "????? ?????? ?? ???? ????." };
        }

        try {
          const result = await apiRequestOtp(normalizedPhone);

          return {
            error: null,
            devCode:
              typeof result?.dev_code === "string"
                ? result.dev_code
                : undefined,
          };
        } catch (error: any) {
          console.error("OTP request failed:", error);

          return {
            error:
              error?.message ||
              "????? ?? ????? ????? ???.",
          };
        }
      },

      async verifyOtp(phone, code, role) {
        const normalizedPhone = phone.trim();
        const normalizedCode = code.trim();

        if (!normalizedPhone) {
          return "????? ?????? ?? ???? ????.";
        }

        if (!/^\d{6}$/.test(normalizedCode)) {
          return "?? ????? ???? ? ??? ????.";
        }

        try {
          const result = await apiVerifyOtp(
            normalizedPhone,
            normalizedCode,
          );

          const apiUser = normalizeApiUser(result);

          if (
            !apiUser ||
            apiUser.id === undefined ||
            !apiUser.name ||
            !apiUser.phone
          ) {
            return "??????? ????? ?? ???? ????? ????.";
          }

          if (apiUser.role && apiUser.role !== role) {
            return "??? ??? ???? ?? ???? ?????????? ?????? ?????.";
          }

          await unlockVault();

          const localUser = apiUserToLocalUser(
            apiUser,
            "",
          );

          const existing = await db.users.get(localUser.id);

          if (existing) {
            await db.users.update(localUser.id, {
              name: localUser.name,
              phone: localUser.phone,
              role: localUser.role,
            });
          } else {
            await db.users.put(localUser);
          }

          await writeSession(localUser.id);
          setUser(toPublic(localUser));

          return null;
        } catch (error: any) {
          console.error("OTP verification failed:", error);

          return (
            error?.message ||
            "?? ????? ???? ???? ?? ????? ??? ???."
          );
        }
      },
      async login(
        identity,
        password,
        role,
      ) {
        const id = identity.trim();

        if (!id || !password) {
          return "شماره موبایل و رمز عبور را وارد کنید.";
        }

        const lockKey =
          `${role}:${id}`;

        const lock =
          lockStatus(lockKey);

        if (lock.locked) {
          return lock.message;
        }

        try {
          /*
           * REAL BACKEND LOGIN
           *
           * Authentication is now performed
           * by FastAPI, not IndexedDB.
           */
          const result =
            await apiLogin(
              id,
              password,
            );

          const apiUser =
            normalizeApiUser(result);

          if (
            !apiUser ||
            apiUser.id === undefined ||
            !apiUser.name ||
            !apiUser.phone
          ) {
            return "بازگشتی سرور نامعتبر است.";
          }

          if (
            apiUser.role &&
            apiUser.role !== role
          ) {
            return "نقش کاربر با نقش انتخابی مت�Aاوت است.";
          }

          clearFails(lockKey);

          await unlockVault();

          /*
           * Keep a local cache so existing
           * application screens continue working.
           */
          const localUser =
            apiUserToLocalUser(
              apiUser,
              password,
            );

          const existing =
            await db.users.get(
              localUser.id,
            );

          if (existing) {
            await db.users.update(
              localUser.id,
              {
                name: localUser.name,
                phone: localUser.phone,
                role: localUser.role,
              },
            );
          } else {
            await db.users.put(
              localUser,
            );
          }

          await writeSession(
            localUser.id,
          );

          setUser(
            toPublic(localUser),
          );

          return null;
        } catch (error) {
          console.error(
            "Backend login failed:",
            error,
          );

          return registerFail(
            lockKey,
          );
        }
      },

      async register(payload) {
        const policy =
          passwordPolicy(
            payload.password,
          );

        if (policy) {
          return policy;
        }

        if (
          !payload.name.trim() ||
          !payload.phone.trim()
        ) {
          return "نام و موبایل را وارد کنید.";
        }

        if (
          payload.role === "patient" &&
          payload.nationalId &&
          payload.nationalId.length < 10
        ) {
          return "کد ملی نادرست است.";
        }

        try {
          /*
           * REAL BACKEND REGISTER
           *
           * The backend currently accepts:
           * name, phone, password, role
           */
          const apiUser =
            await apiRegister(
              payload.name.trim(),
              payload.phone.trim(),
              payload.password,
              payload.role,
            );

          if (
            !apiUser ||
            apiUser.id === undefined
          ) {
            return "ثبت‌نام در سرور نامو�Aق بود.";
          }

          await unlockVault();

          const localUser =
            apiUserToLocalUser(
              apiUser,
              payload.password,
            );

          /*
           * Cache the authenticated user locally.
           */
          await db.users.put(
            localUser,
          );

          /*
           * Keep the patient profile locally
           * for the current frontend screens.
           */
          if (
            payload.role === "patient"
          ) {
            const existingProfile =
              await db.profiles
                .where("userId")
                .equals(localUser.id)
                .first();

            if (!existingProfile) {
              await db.profiles.add({
                id: crypto.randomUUID(),
                userId: localUser.id,
                nationalId:
                  payload.nationalId || "",
                age:
                  payload.age || 0,
                heightCm:
                  payload.heightCm || 0,
                weightKg:
                  payload.weightKg || 0,
                gender:
                  payload.gender || "زن",
                bloodType:
                  payload.bloodType ||
                  "نامشخص",
                caregiverPhone:
                  payload.caregiverPhone ||
                  "",
                conditions:
                  payload.conditions || [],
                allergies:
                  payload.allergies ||
                  "ندارد",
                smoker: false,
              });
            }
          }

          await writeSession(
            localUser.id,
          );

          setUser(
            toPublic(localUser),
          );

          return null;
        } catch (error: any) {
          console.error(
            "Backend registration failed:",
            error,
          );

          return (
            error?.message ||
            "ثبت‌نام نامو�Aق بود."
          );
        }
      },

      async changePassword(
        current,
        next,
      ) {
        /*
         * Password changes should eventually
         * be handled by a dedicated backend
         * endpoint.
         *
         * For now we keep the existing local
         * password-change behavior disabled
         * instead of pretending it changes the
         * server password.
         */
        if (!user) {
          return "وارد حساب نشده‌اید.";
        }

        return "تغییر رمز عبور سرور هنوز �Aعال نشده است.";
      },
    }),
    [user, ready],
  );

  return (
    <AuthContext.Provider value={value}>
      {children}
    </AuthContext.Provider>
  );
}

export function useAuth() {
  const ctx =
    useContext(AuthContext);

  if (!ctx) {
    throw new Error("Auth");
  }

  return ctx;
}

