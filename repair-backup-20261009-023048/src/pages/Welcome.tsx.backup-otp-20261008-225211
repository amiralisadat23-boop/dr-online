import { useEffect, useState } from "react";
import { Link, useNavigate } from "react-router-dom";
import { Activity, HeartHandshake, Stethoscope } from "lucide-react";
import { useAuth } from "../auth";
import type { Role } from "../types";

export function Welcome() {
  const { user, ready } = useAuth();
  const navigate = useNavigate();
  useEffect(() => {
    if (ready && user) navigate("/app", { replace: true });
  }, [ready, user, navigate]);

  return (
    <div className="phone-shell bg-paper min-h-dvh px-5 pt-10 pb-8 relative overflow-hidden">
      <div className="absolute -left-10 -top-8 w-40 h-40 rounded-full bg-teal/15 floaty" />
      <div className="absolute -right-8 top-24 w-28 h-28 rounded-full bg-coral/15 floaty" />
      <p className="text-teal font-bold tracking-wide rise">DR ONLINE</p>
      <h1 className="mt-3 text-4xl font-extrabold leading-[1.2] rise delay-1">
        مراقبت سلامت
        <br />
        در کنار هم
      </h1>
      <p className="mt-3 text-muted leading-7 rise delay-2">
        بیمار علائم را ثبت می‌کند، مراقب وضعیت را می‌بیند و پزشک پرونده را زیر نظر دارد — با یک همراه هوشمند.
      </p>

      <div className="mt-8 space-y-3 rise delay-3 stagger">
        <RoleCard
          to="/login/patient"
          icon={<Activity />}
          title="من بیمار هستم"
          desc="ثبت قند، فشار، دارو و پرونده پزشکی"
        />
        <RoleCard
          to="/login/caregiver"
          icon={<HeartHandshake />}
          title="من مراقب هستم"
          desc="نظارت روی بیمار، هشدار و یادداشت مراقبت"
        />
        <RoleCard
          to="/login/doctor"
          icon={<Stethoscope />}
          title="من پزشک هستم"
          desc="پنل بیماران، روند علائم و توصیه پزشکی"
        />
      </div>
    </div>
  );
}

function RoleCard({
  to,
  icon,
  title,
  desc,
}: {
  to: string;
  icon: React.ReactNode;
  title: string;
  desc: string;
}) {
  return (
    <Link to={to} className="card pressable rounded-3xl p-4 flex items-center gap-4 text-right rise">
      <div className="flex-1 min-w-0">
        <p className="font-bold">{title}</p>
        <p className="text-sm text-muted mt-0.5">{desc}</p>
      </div>
      <div className="w-12 h-12 rounded-2xl bg-teal text-white grid place-items-center shrink-0">{icon}</div>
    </Link>
  );
}

export function Login({ role }: { role: Role }) {
  const { login } = useAuth();
  const navigate = useNavigate();
  const [identity, setIdentity] = useState("");
  const [password, setPassword] = useState("");
  const [busy, setBusy] = useState(false);
  const [error, setError] = useState<string | null>(null);

  const title =
    role === "patient" ? "ورود بیمار" : role === "caregiver" ? "ورود مراقب" : "ورود پزشک";
  const placeholder = role === "patient" ? "کد ملی" : "شماره موبایل";
  const hint =
    role === "patient"
      ? "نمونه آزمایشی: کد ملی 0012345678 رمز 123456"
      : role === "caregiver"
        ? "نمونه آزمایشی: 09121234567 رمز 123456"
        : "نمونه آزمایشی: 09127654321 رمز 123456";

  return (
    <div className="phone-shell bg-paper min-h-dvh px-5 pt-10">
      <Link to="/" className="text-sm text-teal">
        بازگشت
      </Link>
      <h1 className="mt-6 text-3xl font-extrabold rise">{title}</h1>
      <p className="text-muted mt-2 text-sm rise delay-1">{hint}</p>
      <form
        className="mt-8 space-y-4 rise delay-2"
        onSubmit={async (e) => {
          e.preventDefault();
          setBusy(true);
          const err = await login(identity, password, role);
          setBusy(false);
          if (err) setError(err);
          else navigate("/app");
        }}
      >
        <Field label={placeholder} value={identity} onChange={setIdentity} autoComplete="username" />
        <Field label="رمز عبور" value={password} onChange={setPassword} type="password" autoComplete="current-password" />
        {error && <p className="text-coral text-sm">{error}</p>}
        <button disabled={busy} className="w-full h-12 rounded-2xl bg-teal text-white font-bold pressable disabled:opacity-60">
          {busy ? "در حال ورود..." : "ورود به حساب"}
        </button>
      </form>
      <Link to={`/register/${role}`} className="block text-center mt-5 text-teal font-bold">
        حساب ندارم، ثبت‌نام می‌کنم
      </Link>
    </div>
  );
}

function Field({
  label,
  value,
  onChange,
  type = "text",
  autoComplete,
}: {
  label: string;
  value: string;
  onChange: (v: string) => void;
  type?: string;
  autoComplete?: string;
}) {
  return (
    <label className="block">
      <span className="text-sm text-muted">{label}</span>
      <input
        className="mt-1 w-full h-12 rounded-2xl bg-white px-4 outline-none border border-black/5"
        value={value}
        type={type}
        autoComplete={autoComplete}
        onChange={(e) => onChange(e.target.value)}
      />
    </label>
  );
}

const CONDITIONS = ["دیابت", "فشار خون", "بیماری قلبی", "آسم", "کلیوی", "تیروئید"];

export function Register({ role }: { role: Role }) {
  const { register } = useAuth();
  const navigate = useNavigate();
  const [error, setError] = useState<string | null>(null);
  const [form, setForm] = useState({
    name: "",
    phone: "",
    password: "",
    nationalId: "",
    age: "45",
    heightCm: "165",
    weightKg: "70",
    gender: "زن" as "زن" | "مرد",
    bloodType: "A+",
    caregiverPhone: "",
    allergies: "",
    conditions: [] as string[],
    relation: "فرزند",
    patientNationalId: "",
  });

  const set = (k: string, v: string) => setForm((f) => ({ ...f, [k]: v }));

  return (
    <div className="phone-shell bg-paper min-h-dvh px-5 pt-10 pb-10">
      <Link to={`/login/${role}`} className="text-sm text-teal">
        بازگشت
      </Link>
      <h1 className="mt-6 text-3xl font-extrabold">ثبت‌نام</h1>
      <p className="text-muted mt-2 text-sm">رمز حداقل ۸ کاراکتر و ترکیبی از حرف و عدد باشد.</p>
      <form
        className="mt-6 space-y-3"
        onSubmit={async (e) => {
          e.preventDefault();
          const err = await register({
            role,
            name: form.name,
            phone: form.phone,
            password: form.password,
            nationalId: form.nationalId,
            age: Number(form.age),
            heightCm: Number(form.heightCm),
            weightKg: Number(form.weightKg),
            gender: form.gender,
            bloodType: form.bloodType,
            caregiverPhone: form.caregiverPhone,
            conditions: form.conditions,
            allergies: form.allergies,
            relation: form.relation,
            patientNationalId: form.patientNationalId,
          });
          if (err) setError(err);
          else navigate("/app");
        }}
      >
        <Field label="نام و نام خانوادگی" value={form.name} onChange={(v) => set("name", v)} />
        <Field label="شماره موبایل" value={form.phone} onChange={(v) => set("phone", v)} />
        <Field
          label="رمز عبور"
          value={form.password}
          onChange={(v) => set("password", v)}
          type="password"
          autoComplete="new-password"
        />

        {role === "patient" && (
          <>
            <Field label="کد ملی" value={form.nationalId} onChange={(v) => set("nationalId", v)} />
            <div className="grid grid-cols-3 gap-2">
              <Field label="سن" value={form.age} onChange={(v) => set("age", v)} />
              <Field label="قد (سانتی‌متر)" value={form.heightCm} onChange={(v) => set("heightCm", v)} />
              <Field label="وزن" value={form.weightKg} onChange={(v) => set("weightKg", v)} />
            </div>
            <Field label="شماره مراقب" value={form.caregiverPhone} onChange={(v) => set("caregiverPhone", v)} />
            <Field label="گروه خونی" value={form.bloodType} onChange={(v) => set("bloodType", v)} />
            <Field label="حساسیت دارویی" value={form.allergies} onChange={(v) => set("allergies", v)} />
            <p className="text-sm text-muted pt-1">بیماری‌های زمینه‌ای</p>
            <div className="flex flex-wrap gap-2">
              {CONDITIONS.map((c) => {
                const on = form.conditions.includes(c);
                return (
                  <button
                    type="button"
                    key={c}
                    onClick={() =>
                      setForm((f) => ({
                        ...f,
                        conditions: on ? f.conditions.filter((x) => x !== c) : [...f.conditions, c],
                      }))
                    }
                    className={`px-3 py-1.5 rounded-full text-sm ${on ? "bg-teal text-white" : "bg-white"}`}
                  >
                    {c}
                  </button>
                );
              })}
            </div>
          </>
        )}

        {role === "caregiver" && (
          <>
            <Field
              label="کد ملی بیمار تحت نظر (اختیاری)"
              value={form.patientNationalId}
              onChange={(v) => set("patientNationalId", v)}
            />
            <Field label="نسبت با بیمار" value={form.relation} onChange={(v) => set("relation", v)} />
          </>
        )}

        {error && <p className="text-coral text-sm">{error}</p>}
        <button className="w-full h-12 rounded-2xl bg-teal text-white font-bold mt-2 pressable">ساخت حساب</button>
      </form>
    </div>
  );
}
