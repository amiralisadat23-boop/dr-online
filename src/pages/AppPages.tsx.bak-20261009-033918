export function AlertsPage() {
  const { user } = useAuth();
  const [alerts, setAlerts] = useState<(Alert & { patientName: string })[]>([]);
  useEffect(() => {
    (async () => {
      if (!user) return;
      const links = await db.links.where("fromUserId").equals(user.id).toArray();
      const ids = user.role === "patient" ? [user.id] : links.map((l) => l.patientUserId);
      const all = await db.alerts.toArray();
      const rows = [];
      for (const a of all.filter((x) => ids.includes(x.patientUserId))) {
        const p = await db.users.get(a.patientUserId);
        rows.push({ ...a, patientName: p?.name || "" });
      }
      setAlerts(rows.sort((a, b) => b.at - a.at));
    })();
  }, [user]);

  return (
    <div className="space-y-3">
      <h2 className="text-2xl font-extrabold">هشدارها</h2>
      {alerts.map((a) => (
        <div key={a.id} className="card rounded-3xl p-4">
          <p className={`text-xs font-bold ${a.level === "danger" ? "text-coral" : "text-amber-700"}`}>
            {a.patientName}
          </p>
          <p className="font-bold mt-1">{a.title}</p>
          <p className="text-sm text-muted mt-1">{a.body}</p>
        </div>
      ))}
      {alerts.length === 0 && <p className="text-muted">هشداری نیست.</p>}
    </div>
  );
}

export function MePage() {
  const { user, logout, changePassword } = useAuth();
  const navigate = useNavigate();
  const [current, setCurrent] = useState("");
  const [next, setNext] = useState("");
  const [msg, setMsg] = useState<string | null>(null);
  const [err, setErr] = useState<string | null>(null);
  const roleFa = user?.role === "doctor" ? "پزشک" : user?.role === "caregiver" ? "مراقب" : "بیمار";

  return (
    <div className="space-y-4 rise">
      <div className="card rounded-3xl p-5 space-y-3">
        <h2 className="text-2xl font-extrabold">{user?.name}</h2>
        <Row k="نقش" v={roleFa} />
        <Row k="موبایل" v={user?.phone} />
        <Row k="کد ملی" v={user?.nationalId} />
        <p className="text-sm text-muted leading-7 pt-2">
          پایگاه داده روی خود گوشی است و به سرور اینترنتی وصل نیست. رمز حساب با PBKDF2 هش می‌شود، یادداشت و گفتگو با AES-256-GCM رمز می‌شود، نشست امضاشده ۸ ساعته است و ورود اشتباه چندباره قفل می‌شود. پشتیبان ابری اندروید برای این برنامه خاموش است.
        </p>
      </div>
      <form
        className="card rounded-3xl p-5 space-y-3"
        onSubmit={async (e) => {
          e.preventDefault();
          setErr(null);
          setMsg(null);
          const res = await changePassword(current, next);
          if (res) setErr(res);
          else {
            setMsg("رمز با موفقیت عوض شد.");
            setCurrent("");
            setNext("");
          }
        }}
      >
        <p className="font-bold">تغییر رمز حساب</p>
        <input
          className="w-full h-12 rounded-2xl bg-paper px-4"
          type="password"
          placeholder="رمز فعلی"
          value={current}
          onChange={(e) => setCurrent(e.target.value)}
        />
        <input
          className="w-full h-12 rounded-2xl bg-paper px-4"
          type="password"
          placeholder="رمز جدید (حداقل ۸ کاراکتر، حرف و عدد)"
          value={next}
          onChange={(e) => setNext(e.target.value)}
        />
        {err && <p className="text-coral text-sm">{err}</p>}
        {msg && <p className="text-ok text-sm">{msg}</p>}
        <button className="w-full h-11 rounded-2xl bg-teal text-white font-bold">ذخیره رمز جدید</button>
      </form>
      <button
        className="w-full h-12 rounded-2xl bg-coral text-white font-bold pressable"
        onClick={() => {
          logout();
          navigate("/");
        }}
      >
        خروج از حساب
      </button>
    </div>
  );
}

