export function Register({ role }: { role: Role }) {
  const { register } = useAuth();
  const navigate = useNavigate();

  const [error, setError] = useState<string | null>(null);

  const [form, setForm] = useState({
    name: "",
    phone: "",
    password: "",
    nationalId: "",
    age: "45",
    heightCm: "165",
    weightKg: "70",
    gender: "ز�?" as "ز�?" | "�.رد",
    bloodType: "A+",
    caregiverPhone: "",
    allergies: "",
    conditions: [] as string[],
    relation: "فرز�?د",
    patientNationalId: "",
  });

  const set = (k: string, v: string) =>
    setForm((f) => ({ ...f, [k]: v }));

  return (
    <div className="phone-shell bg-paper min-h-dvh px-5 pt-10 pb-10">
      <Link to={`/login/${role}`} className="text-sm text-teal">
        بازگشت
      </Link>

      <h1 className="mt-6 text-3xl font-extrabold">
        ثبت�?O�?ا�.
      </h1>

      <p className="text-muted mt-2 text-sm">
        ر�.ز حدا�,�" ۸ کاراکتر �^ ترک�Oب�O از حر�^ف �^ عدد باشد.
      </p>

      <form
        className="mt-6 space-y-3"
        onSubmit={async (e) => {
          e.preventDefault();

          const err = await register({
            role,
            name: form.name,
            phone: form.phone,
            password: form.password,
            nationalId: form.nationalId,
            age: Number(form.age),
            heightCm: Number(form.heightCm),
            weightKg: Number(form.weightKg),
            gender: form.gender,
            bloodType: form.bloodType,
            caregiverPhone: form.caregiverPhone,
            conditions: form.conditions,
            allergies: form.allergies,
            relation: form.relation,
            patientNationalId: form.patientNationalId,
          });

          if (err) {
            setError(err);
          } else {
            navigate("/app");
          }
        }}
      >
        <Field
          label="�?ا�. �^ �?ا�. خا�?�^ادگ�O"
          value={form.name}
          onChange={(v) => set("name", v)}
        />

        <Field
          label="ش�.ار�? �.�^با�O�""
          value={form.phone}
          onChange={(v) => set("phone", v)}
        />

        <Field
          label="ر�.ز عب�^ر"
          value={form.password}
          onChange={(v) => set("password", v)}
          type="password"
          autoComplete="new-password"
        />

        {role === "patient" && (
          <>
            <Field
              label="کد �.�"�O"
              value={form.nationalId}
              onChange={(v) => set("nationalId", v)}
            />

            <div className="grid grid-cols-3 gap-2">
              <Field
                label="س�?"
                value={form.age}
                onChange={(v) => set("age", v)}
              />

              <Field
                label="�,د (سا�?ت�O�?O�.تر)"
                value={form.heightCm}
                onChange={(v) => set("heightCm", v)}
              />

              <Field
                label="�^ز�?"
                value={form.weightKg}
                onChange={(v) => set("weightKg", v)}
              />
            </div>

            <Field
              label="ش�.ار�? �.را�,ب"
              value={form.caregiverPhone}
              onChange={(v) => set("caregiverPhone", v)}
            />

            <Field
              label="گر�^�? خ�^�?�O"
              value={form.bloodType}
              onChange={(v) => set("bloodType", v)}
            />

            <Field
              label="حساس�Oت دار�^�O�O"
              value={form.allergies}
              onChange={(v) => set("allergies", v)}
            />

            <p className="text-sm text-muted pt-1">
              ب�O�.ار�O�?O�?ا�O ز�.�O�?�?�?Oا�O
            </p>

            <div className="flex flex-wrap gap-2">
              {CONDITIONS.map((c) => {
                const on = form.conditions.includes(c);

                return (
                  <button
                    type="button"
                    key={c}
                    onClick={() =>
                      setForm((f) => ({
                        ...f,
                        conditions: on
                          ? f.conditions.filter((x) => x !== c)
                          : [...f.conditions, c],
                      }))
                    }
                    className={`px-3 py-1.5 rounded-full text-sm ${
                      on
                        ? "bg-teal text-white"
                        : "bg-white"
                    }`}
                  >
                    {c}
                  </button>
                );
              })}
            </div>
          </>
        )}

        {role === "caregiver" && (
          <>
            <Field
              label="کد �.�"�O ب�O�.ار تحت �?ظر (اخت�Oار�O)"
              value={form.patientNationalId}
              onChange={(v) =>
                set("patientNationalId", v)
              }
            />

            <Field
              label="�?سبت با ب�O�.ار"
              value={form.relation}
              onChange={(v) => set("relation", v)}
            />
          </>
        )}

        {error && (
          <p className="text-coral text-sm">
            {error}
          </p>
        )}

        <button className="w-full h-12 rounded-2xl bg-teal text-white font-bold mt-2 pressable">
          ساخت حساب
        </button>
      </form>
    </div>
  );
}

