function RoleCard({
  to,
  icon,
  title,
  desc,
}: {
  to: string;
  icon: React.ReactNode;
  title: string;
  desc: string;
}) {
  return (
    <Link
      to={to}
      className="card pressable rounded-3xl p-4 flex items-center gap-4 text-right rise"
    >
      <div className="flex-1 min-w-0">
        <p className="font-bold">{title}</p>
        <p className="text-sm text-muted mt-0.5">{desc}</p>
      </div>

      <div className="w-12 h-12 rounded-2xl bg-teal text-white grid place-items-center shrink-0">
        {icon}
      </div>
    </Link>
  );
}

export function Login({ role }: { role: Role }) {
  const { requestOtp, verifyOtp } = useAuth();
  const navigate = useNavigate();

  const [phone, setPhone] = useState("");
  const [code, setCode] = useState("");
  const [step, setStep] = useState<"phone" | "otp">("phone");
  const [busy, setBusy] = useState(false);
  const [error, setError] = useState<string | null>(null);
  const [devCode, setDevCode] = useState<string | null>(null);

  const title =
    role === "patient"
      ? "�^ر�^د ب�O�.ار"
      : role === "caregiver"
        ? "�^ر�^د �.را�,ب"
        : "�^ر�^د پزشک";

  async function sendCode() {
    setError(null);

    const normalizedPhone = phone.trim();

    if (!normalizedPhone) {
      setError("ش�.ار�? �.�^با�O�" را �^ارد ک�?�Oد.");
      return;
    }

    setBusy(true);

    try {
      const result = await requestOtp(normalizedPhone);

      if (result.error) {
        setError(result.error);
        return;
      }

      setDevCode(result.devCode || null);
      setStep("otp");
    } finally {
      setBusy(false);
    }
  }

  async function confirmCode() {
    setError(null);

    if (!/^\d{6}$/.test(code.trim())) {
      setError("کد تأ�O�Oد با�Oد ۶ ر�,�. باشد.");
      return;
    }

    setBusy(true);

    try {
      const result = await verifyOtp(phone, code, role);

      if (result === "REGISTRATION_REQUIRED") {
        navigate("/complete-registration", { replace: true });
        return;
      }

      if (result) {
        setError(result);
        return;
      }

      navigate("/app", { replace: true });
    } finally {
      setBusy(false);
    }
  }

  return (
    <div className="phone-shell bg-paper min-h-dvh px-5 pt-10">
      <Link to="/" className="text-sm text-teal">
        بازگشت
      </Link>

      <h1 className="mt-6 text-3xl font-extrabold rise">
        {title}
      </h1>

      {step === "phone" ? (
        <>
          <p className="text-muted mt-2 text-sm">
            ش�.ار�? �.�^با�O�" خ�^د را �^ارد ک�?�Oد تا کد تأ�O�Oد برا�O ش�.ا ارسا�" ش�^د.
          </p>

          <form
            className="mt-8 space-y-4 rise delay-2"
            onSubmit={(e) => {
              e.preventDefault();
              void sendCode();
            }}
          >
            <Field
              label="ش�.ار�? �.�^با�O�""
              value={phone}
              onChange={setPhone}
              type="tel"
              autoComplete="tel"
            />

            {error && (
              <p className="text-coral text-sm">
                {error}
              </p>
            )}

            <button
              type="submit"
              disabled={busy}
              className="w-full h-12 rounded-2xl bg-teal text-white font-bold pressable disabled:opacity-60"
            >
              {busy ? "در حا�" ارسا�"..." : "ارسا�" کد تأ�O�Oد"}
            </button>
          </form>
        </>
      ) : (
        <>
          <p className="text-muted mt-2 text-sm">
            کد ۶ ر�,�.�O ارسا�"�?Oشد�? برا�O ش�.ار�?
            <br />
            <span className="font-bold text-ink">
              {phone}
            </span>
            <br />
            را �^ارد ک�?�Oد.
          </p>

          <form
            className="mt-8 space-y-4 rise delay-2"
            onSubmit={(e) => {
              e.preventDefault();
              void confirmCode();
            }}
          >
            <Field
              label="کد تأ�O�Oد ۶ ر�,�.�O"
              value={code}
              onChange={(value) =>
                setCode(
                  value.replace(/\D/g, "").slice(0, 6),
                )
              }
              type="tel"
              autoComplete="one-time-code"
            />

            {devCode && (
              <div className="rounded-2xl bg-teal/10 p-3 text-sm">
                کد تست ت�^سع�?:
                <span className="font-extrabold mr-2">
                  {devCode}
                </span>
              </div>
            )}

            {error && (
              <p className="text-coral text-sm">
                {error}
              </p>
            )}

            <button
              type="submit"
              disabled={busy || code.length !== 6}
              className="w-full h-12 rounded-2xl bg-teal text-white font-bold pressable disabled:opacity-60"
            >
              {busy ? "در حا�" بررس�O..." : "تأ�O�Oد �^ �^ر�^د"}
            </button>

            <button
              type="button"
              disabled={busy}
              onClick={() => {
                setCode("");
                setError(null);
                setDevCode(null);
                setStep("phone");
              }}
              className="w-full h-11 rounded-2xl bg-white font-bold"
            >
              تغ�O�Oر ش�.ار�?
            </button>
          </form>
        </>
      )}

      <Link
        to={`/register/${role}`}
        className="block text-center mt-5 text-teal font-bold"
      >
        حساب �?دار�.�O ثبت�?O�?ا�. �.�O�?Oک�?�.
      </Link>
    </div>
  );
}

function Field({
  label,
  value,
  onChange,
  type = "text",
  autoComplete,
}: {
  label: string;
  value: string;
  onChange: (v: string) => void;
  type?: string;
  autoComplete?: string;
}) {
  return (
    <label className="block">
      <span className="text-sm text-muted">{label}</span>

      <input
        className="mt-1 w-full h-12 rounded-2xl bg-white px-4 outline-none border border-black/5"
        value={value}
        type={type}
        autoComplete={autoComplete}
        onChange={(e) => onChange(e.target.value)}
      />
    </label>
  );
}

